# ==========================================================
#  Never Land  |  ملف الإعدادات (انسخه إلى .env وعدّل القيم)
# ==========================================================

# ---------- معلومات البوت (إلزامي) ----------
# من https://discord.com/developers/applications
DISCORD_TOKEN=ضع_توكن_البوت_هنا
CLIENT_ID=ضع_ايدي_التطبيق_هنا
# توكن التطبيق نفسه (Bot token) هو نفسه DISCORD_TOKEN، بعض الواجهات تحتاجه منفصل
CLIENT_SECRET=ضع_السر_هنا

# ---------- لوحة التحكم (Dashboard) ----------
# رابط الموقع العام (اختياري): اتركه فارغًا ليُحدَّد تلقائيًا.
#  - محليًا: http://localhost:3000  (يعمل فقط على الجهاز الذي يشغّل npm start)
#  - على الإنترنت: https://اسم-مشروعك.up.railway.app أو نطاقك الخاص
#  - الرابط المذكور هنا لازم يطابق حرفياً Developer Portal > OAuth2 > Redirects
DASHBOARD_URL=
DASHBOARD_PORT=3000
# سر الجلسات: نص طويل وعشوائي وفريد — غيّره حتمًا قبل النشر.
# بدونه تُزوَّر كوكيز الدخول (neverland.sid) ويقدر أي شخص ينتحل أي حساب، حتى المالك.
# ولّد سرًا قويًا بـ:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=غيّر_هذا_النص_الطويل_لحماية_الجلسات
# الوصول العام: true = أي زائر يفتح الموقع ويشاهد الصفحات والسيرفرات (بلا تعديل)
#                false = الموقع مغلق ولا يفتحه إلا من سجّل دخول بـ Discord
PUBLIC_ACCESS=false
# تأكيد الدخول: true = الموقع ما يفتحه إلا من سجّل دخول بحساب Discord
LOGIN_REQUIRED=true
# الرول المطلوب لاستخدام الموقع (معرّف الرول) — من لا يملكه يرى صفحة «الوصول مقيّد»
# ⚠️ القيمة أدناه معرّف رول من سيرفر صاحب المشروع — غيّرها إلى معرّف رولك أنت،
#    أو اتركها فارغة لقبول أي عضو مسجّل دخول.
REQUIRED_ROLE_ID=
# مدة كاش فحص الرول بالثواني
ROLE_CACHE_SECONDS=300
# مالك الموقع: معرّف حساب ديسكورد الوحيد الذي يرى لوحة «أعضاء الموقع»
# (قائمة الداخلين + الحظر + المشاهدة فقط).
# ⚠️ إن تركتها فارغة تُستعمل القيمة الافتراضية في src/config.js، وهي معرّف
#    حساب صاحب المشروع الأصلي — أي أنّك ستمنحه صلاحية المالك على موقعك.
#    ضع معرّفك أنت حتمًا. اجلبه بـ: وضع المطوّر ← نسخ معرّف المستخدم.
OWNER_USER_ID=
# حسابات إضافية مسموح لها بإدارة الموقع (اختياري، مفصولة بفواصل)
SITE_ADMINS=
# ضع true لتشغيل اللوحة ببيانات تجريبية بدون تسجيل دخول (للمعاينة فقط)
DEMO_MODE=false

# ---------- إعدادات عامة ----------
# اللغة الافتراضية للبوت: ar أو en
DEFAULT_LANGUAGE=en
# أيدي مطوري البوت (يفصلهم بفاصلة) — عندهم صلاحية أوامر المطوّر
DEVELOPER_IDS=
# مسار قاعدة البيانات
DATABASE_PATH=./data/neverland.db

# ---------- صلاحيات ودّية ----------
# حذف أوامر السلاش القديمة وإعادة تسجيلها عند كل تشغيل (لاستخدام التطوير فقط)
RESET_COMMANDS=false

# رابط دعوة البوت (اختياري — يُبنى تلقائيًا من CLIENT_ID)
# INVITE_URL=https://discord.com/oauth2/authorize?client_id=...&permissions=8&scope=bot%20applications.commands

# ---------- المزامنة الحقيقية مع ديسكورد ----------
# كل كم ثانية تُزامَن أسماء/قنوات/رتب سيرفراتك مع اللوحة (الحد الأدنى 60)
SYNC_INTERVAL_SECONDS=300
# إيقاف المزامنة التلقائية بالكامل عند false
SYNC_ENABLED=true

# ---------- Bot V2 (safe by default) ----------
# Keep false for website-only mode and preview builds. The bot never starts unless true.
RUN_BOT=false
# The first V2 release is limited to this one Discord server.
PRIMARY_GUILD_ID=
# Railway direct Discord REST can be unreliable. Use the separately deployed
# durable relay documented in docs/BOT_V2_PREVIEW.md. Do not commit real values.
DISCORD_REST_MODE=proxy
DISCORD_REST_PROXY_URL=
DISCORD_REST_PROXY_SECRET=
# Local development only, and only when direct Discord REST is known to work:
# ALLOW_DIRECT_DISCORD_REST=false
